# Vercel Connect GitHub connector UID and GitHub App slug.
ENG_AGENT_GITHUB_CONNECTOR=github/pr-review-agent
ENG_AGENT_BOT_NAME=pr-review-agent

# Required, comma-separated automation scope. Use owner/repository names.
ENG_AGENT_REPOSITORIES=your-org/your-repository
ENG_AGENT_BASE_BRANCHES=main

# Every named check must be present and successful on the exact reviewed head SHA.
# Match GitHub's displayed check names exactly.
ENG_AGENT_REQUIRED_CHECKS=lint,test

# Non-success terminal conclusions remain blocked unless explicitly allowlisted.
ENG_AGENT_ALLOWED_NEUTRAL_CHECKS=
ENG_AGENT_ALLOWED_SKIPPED_CHECKS=

ENG_AGENT_MIN_CONFIDENCE=0.9

# Slack review handoff. Leave the channel blank to disable notifications.
ENG_AGENT_SLACK_CONNECTOR=slack/pr-review-agent
ENG_AGENT_SLACK_REVIEW_CHANNEL=
# Comma-separated Slack member IDs to mention for reviewer-ready PRs.
ENG_AGENT_SLACK_REVIEWER_IDS=
